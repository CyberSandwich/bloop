{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloop",
  "main": "src/worker/index.ts",
  // The demo account's sample files are bundled as raw bytes (src/worker/seams/file-source/demo.ts).
  "rules": [{ "type": "Data", "globs": ["**/*.pptx", "**/*.pdf", "**/*.jpg"], "fallthrough": true }],
  "compatibility_date": "2026-11-22",
  // The one public address is PUBLIC_ORIGIN; per-version preview URLs would be more, outside it.
  // workers.dev stays on so old links and QR codes reach the Worker, which answers 301 to PUBLIC_ORIGIN (src/worker/origin.ts).
  "workers_dev": true,
  "preview_urls": false,
  // Cloudflare creates the DNS record and certificate on deploy; no apex record is added by hand.
  "routes": [{ "pattern": "bloop.here", "custom_domain": true }],
  // dist/ is public/ with each JS module minified (ADR 0011). A local `wrangler dev` and `wrangler deploy` rebuild it
  // first, and dev rebuilds on any change under public/. The CI deploy jobs do not build: they swap this command for
  // tools/prebuilt.mjs, which checks the check job's dist/ artifact.
  "build": { "command": "node tools/build-assets-cli.mjs", "watch_dir": "public" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Every path but the static trees, which never carry a page: those the asset layer answers itself (ADR 0010).
    "run_worker_first": ["/*", "!/js/*", "!/css/*", "!/img/*", "!/fonts/*", "!/favicon.svg", "!/apple-touch-icon.png"]
  },
  // Logs on, invocation logs off: an invocation log keeps the full URL, which holds /f/, /b/, /p/ and invite tokens.
  // Query strings are redacted from what is logged anyway. Nothing is sampled out while traffic is this small.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "issues": { "enabled": true }
  },
  // 30000 is the platform default, kept explicit as the ceiling the conversion work (ADR 0019) runs under; the spend guard bounds cost.
  "limits": { "cpu_ms": 30000 },
  // The converter container (ADR 0019) never runs locally: no dev server, test or Playwright run starts Docker.
  "dev": { "enable_containers": false },
  "durable_objects": {
    "bindings": [
      { "name": "SCREEN", "class_name": "Screen" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "USER_LIBRARY", "class_name": "UserLibrary" },
      { "name": "CONVERTER", "class_name": "Converter" },
      { "name": "SPEND_GUARD", "class_name": "SpendGuard" }
    ]
  },
  // The Converter container entry (`containers`, with its image digest under `containers[0].images`) arrives with the
  // image, in the converter change: a container needs its image at deploy.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Screen", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["UserLibrary", "Converter"] },
    { "tag": "v3", "new_sqlite_classes": ["SpendGuard"] }
  ],
  // Created with `wrangler d1 create bloop --jurisdiction eu`; a new account prints a new id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloop",
      "database_id": "ea89d5c2-d40a-424b-a910-c102d98be3cf",
      "migrations_dir": "migrations"
    }
  ],
  // Email Service (ADR 0021). The sender is EMAIL_FROM.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hi@bloop.here"] }],
  "r2_buckets": [
    { "binding": "GUEST_FILES", "bucket_name": "bloop-guest-files", "jurisdiction": "eu" },
    { "binding": "LIBRARY", "bucket_name": "bloop-library", "jurisdiction": "eu" }
  ],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_CLAIM", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_FETCH", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_EXPORT", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_DEMO_CREATE", "namespace_id": "1007", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_DEMO_CLAIM", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_FILES", "namespace_id": "1009", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_CONTROL", "namespace_id": "1010", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_UPGRADE", "namespace_id": "1011", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_CODE", "namespace_id": "1012", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_INVITE", "namespace_id": "1013", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_PASSKEY", "namespace_id": "1014", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_UPLOAD_PART", "namespace_id": "1015", "simple": { "limit": 240, "period": 60 } },
    { "name": "RL_LIBRARY", "namespace_id": "1016", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "1017", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_REPORT", "namespace_id": "1018", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_MEMBER_IP", "namespace_id": "1019", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_MEMBER", "namespace_id": "1020", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["*/5 * * * *", "0 * * * *", "30 3 * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://bloop.here",
    // The workers.dev host is a separate site, so a file served there never shares an origin or a cookie with the app (ADR 0018).
    "FILE_ORIGIN": "https://bloop.dsap.workers.dev",
    // proxy until the direct-upload change lands; convert off until the converter lands. Both are read per request.
    "UPLOAD_MODE": "proxy",
    "CONVERT_MODE": "off",
    "UPLOAD_PART_BYTES": "16777216",
    "UPLOAD_URL_TTL_SECONDS": "300",
    "LIBRARY_QUOTA_BYTES": "5368709120",
    "LIBRARY_MAX_FILE_BYTES": "524288000",
    "LIBRARY_MAX_FILES": "2000",
    "LARGE_FILE_CHOICE_BYTES": "31457280",
    "TRASH_DAYS": "30",
    "INACTIVE_DAYS": "365",
    "INACTIVE_GRACE_DAYS": "30",
    "ACCOUNT_DELETE_GRACE_DAYS": "7",
    "INVITE_TTL_DAYS": "7",
    "EMAIL_CODE_TTL_SECONDS": "600",
    "REAUTH_SECONDS": "300",
    "EMAIL_FROM": "hi@bloop.here",
    // Public widget key; the secret half is the Worker secret TURNSTILE_SECRET_KEY.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGS20bvgkLOdXzU9",
    "FILE_SOURCE": "mock",
    "OPEN_PATH_MODE": "redirect",
    "TOKEN_MODE": "refresh",
    "CODE_LENGTH": "6",
    "CODE_TTL_SECONDS": "60",
    "CODE_GRACE_SECONDS": "10",
    "CLAIM_TIMEOUT_SECONDS": "300",
    "UPLOAD_TIMEOUT_SECONDS": "900",
    "SESSION_MAX_MINUTES": "720",
    "SESSION_DEFAULT_MINUTES": "60",
    "LINK_FIRST_FETCH_SECONDS": "600",
    "LINK_FETCH_WINDOW_SECONDS": "120",
    "LINK_MAX_FETCHES": "10",
    "LINK_MINTS_PER_ITEM": "5",
    "LINK_BINDING_DEFAULT": "log",
    "GRAPH_DOWNLOAD_HOSTS": "*.sharepoint.com,*.files.1drv.com,my.microsoftpersonalcontent.com",
    // Open: with no accounts yet, a guest send is how a real deck reaches a live screen (test/unit/config.test.ts).
    "GUEST_DROP": "open",
    "GUEST_MAX_BYTES": "94371840",
    "GUEST_STORAGE_BUDGET_BYTES": "5368709120",
    // R2 has no platform spending cap: these stop bloop at 50% of the free tier per UTC calendar month (1M class A, 10M class B), since the billing period may not align with calendar months.
    "R2_CLASS_A_MONTHLY_CAP": "500000",
    "R2_CLASS_B_MONTHLY_CAP": "5000000",
    "DEMO_ENABLED": "true",
    "DEMO_MAX_MINUTES": "120",
    "DEMO_GUEST_MAX_BYTES": "26214400",
    "DEMO_MAX_CONCURRENT": "100",
    "DEMO_MAX_PER_IP": "12",
    "AUDIT_RETENTION_DAYS": "180",
    "METRICS_RETENTION_DAYS": "90",
    "DEMO_RETENTION_DAYS": "7",
    "GRANT_IDLE_DAYS": "30",
    "ENTRA_AUTHORITY": "https://login.microsoftonline.com/organizations/v2.0",
    "ENTRA_CLIENT_ID": "",
    "ENTRA_SCOPES": "openid offline_access Files.Read",
    "TOKEN_KEK_CURRENT": "k1"
  },
  // Staging (docs/setup.md): its own script, Durable Object namespaces, D1 and EU buckets, tiny caps, Cloudflare's published
  // Turnstile test keys, the */5 breaker cron only. Bindings, vars and ratelimits are not inherited, so they are repeated; test/unit/staging.test.ts keeps them in step.
  // routes is emptied so it does not inherit the custom domain; migrations and workers_dev are inherited.
  // STAGING_D1_ID is replaced inside the CI job (tools/staging.mjs), never committed.
  "env": {
    "staging": {
      "name": "bloop-staging",
      "routes": [],
      "durable_objects": {
        "bindings": [
          {
            "name": "SCREEN",
            "class_name": "Screen"
          },
          {
            "name": "DIRECTORY",
            "class_name": "Directory"
          },
          {
            "name": "USER_LIBRARY",
            "class_name": "UserLibrary"
          },
          {
            "name": "CONVERTER",
            "class_name": "Converter"
          },
          {
            "name": "SPEND_GUARD",
            "class_name": "SpendGuard"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bloop-staging",
          "database_id": "STAGING_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "GUEST_FILES",
          "bucket_name": "bloop-staging-guest",
          "jurisdiction": "eu"
        },
        {
          "binding": "LIBRARY",
          "bucket_name": "bloop-staging-library",
          "jurisdiction": "eu"
        }
      ],
      "ratelimits": [
        {
          "name": "RL_CREATE",
          "namespace_id": "2001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_CLAIM",
          "namespace_id": "2002",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RL_FETCH",
          "namespace_id": "2003",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "RL_UPLOAD",
          "namespace_id": "2004",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "RL_AUTH",
          "namespace_id": "2005",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_EXPORT",
          "namespace_id": "2006",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_DEMO_CREATE",
          "namespace_id": "2007",
          "simple": {
            "limit": 12,
            "period": 60
          }
        },
        {
          "name": "RL_DEMO_CLAIM",
          "namespace_id": "2008",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RL_FILES",
          "namespace_id": "2009",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RL_CONTROL",
          "namespace_id": "2010",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "RL_UPGRADE",
          "namespace_id": "2011",
          "simple": {
            "limit": 30,
            "period": 60
          }
        },
        {
          "name": "RL_CODE",
          "namespace_id": "2012",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "RL_INVITE",
          "namespace_id": "2013",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "RL_PASSKEY",
          "namespace_id": "2014",
          "simple": {
            "limit": 20,
            "period": 60
          }
        },
        {
          "name": "RL_UPLOAD_PART",
          "namespace_id": "2015",
          "simple": {
            "limit": 240,
            "period": 60
          }
        },
        {
          "name": "RL_LIBRARY",
          "namespace_id": "2016",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "RL_ADMIN",
          "namespace_id": "2017",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "RL_REPORT",
          "namespace_id": "2018",
          "simple": {
            "limit": 5,
            "period": 60
          }
        },
        {
          "name": "RL_MEMBER_IP",
          "namespace_id": "2019",
          "simple": {
            "limit": 300,
            "period": 60
          }
        },
        {
          "name": "RL_MEMBER",
          "namespace_id": "2020",
          "simple": {
            "limit": 120,
            "period": 60
          }
        }
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "PUBLIC_ORIGIN": "https://bloop-staging.dsap.workers.dev",
        "FILE_ORIGIN": "",
        "UPLOAD_MODE": "proxy",
        "CONVERT_MODE": "off",
        "UPLOAD_PART_BYTES": "16777216",
        "UPLOAD_URL_TTL_SECONDS": "300",
        "LIBRARY_QUOTA_BYTES": "104857600",
        "LIBRARY_MAX_FILE_BYTES": "52428800",
        "LIBRARY_MAX_FILES": "50",
        "LARGE_FILE_CHOICE_BYTES": "31457280",
        "TRASH_DAYS": "30",
        "INACTIVE_DAYS": "365",
        "INACTIVE_GRACE_DAYS": "30",
        "ACCOUNT_DELETE_GRACE_DAYS": "7",
        "INVITE_TTL_DAYS": "7",
        "EMAIL_CODE_TTL_SECONDS": "600",
        "REAUTH_SECONDS": "300",
        "EMAIL_FROM": "hi@bloop.here",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "FILE_SOURCE": "mock",
        "OPEN_PATH_MODE": "redirect",
        "TOKEN_MODE": "refresh",
        "CODE_LENGTH": "6",
        "CODE_TTL_SECONDS": "60",
        "CODE_GRACE_SECONDS": "10",
        "CLAIM_TIMEOUT_SECONDS": "300",
        "UPLOAD_TIMEOUT_SECONDS": "900",
        "SESSION_MAX_MINUTES": "720",
        "SESSION_DEFAULT_MINUTES": "60",
        "LINK_FIRST_FETCH_SECONDS": "600",
        "LINK_FETCH_WINDOW_SECONDS": "120",
        "LINK_MAX_FETCHES": "10",
        "LINK_MINTS_PER_ITEM": "5",
        "LINK_BINDING_DEFAULT": "log",
        "GRAPH_DOWNLOAD_HOSTS": "*.sharepoint.com,*.files.1drv.com,my.microsoftpersonalcontent.com",
        "GUEST_DROP": "open",
        "GUEST_MAX_BYTES": "10485760",
        "GUEST_STORAGE_BUDGET_BYTES": "104857600",
        "R2_CLASS_A_MONTHLY_CAP": "10000",
        "R2_CLASS_B_MONTHLY_CAP": "50000",
        "DEMO_ENABLED": "true",
        "DEMO_MAX_MINUTES": "120",
        "DEMO_GUEST_MAX_BYTES": "5242880",
        "DEMO_MAX_CONCURRENT": "10",
        "DEMO_MAX_PER_IP": "5",
        "AUDIT_RETENTION_DAYS": "180",
        "METRICS_RETENTION_DAYS": "90",
        "DEMO_RETENTION_DAYS": "7",
        "GRANT_IDLE_DAYS": "30",
        "ENTRA_AUTHORITY": "https://login.microsoftonline.com/organizations/v2.0",
        "ENTRA_CLIENT_ID": "",
        "ENTRA_SCOPES": "openid offline_access Files.Read",
        "TOKEN_KEK_CURRENT": "k1",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      }
    }
  }
}
