{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloop",
  "main": "src/worker/index.ts",
  // The demo account's sample files are bundled as raw bytes (src/worker/seams/file-source/demo.ts).
  "rules": [{ "type": "Data", "globs": ["**/*.pptx", "**/*.pdf", "**/*.jpg"], "fallthrough": true }],
  "compatibility_date": "2026-11-22",
  // The one public address is PUBLIC_ORIGIN; per-version preview URLs would be more, outside it.
  // workers.dev stays on so old links and QR codes reach the Worker, which answers 301 to PUBLIC_ORIGIN (src/worker/origin.ts).
  "workers_dev": true,
  "preview_urls": false,
  // Cloudflare creates the DNS record and certificate on deploy; no apex record is added by hand.
  "routes": [{ "pattern": "bloop.here", "custom_domain": true }],
  // dist/ is public/ with each JS module minified (ADR 0011). Every `wrangler dev` and `wrangler deploy` rebuilds it
  // first, and dev rebuilds on any change under public/, so no server or upload reads a stale copy.
  "build": { "command": "node tools/build-assets.mjs", "watch_dir": "public" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "SCREEN", "class_name": "Screen" }, { "name": "DIRECTORY", "class_name": "Directory" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Screen", "Directory"] }],
  // Created with `wrangler d1 create bloop --jurisdiction eu`; a new account prints a new id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloop",
      "database_id": "ea89d5c2-d40a-424b-a910-c102d98be3cf",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "GUEST_FILES", "bucket_name": "bloop-guest-files", "jurisdiction": "eu" }],
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_CLAIM", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_FETCH", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_EXPORT", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_DEMO_CREATE", "namespace_id": "1007", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_DEMO_CLAIM", "namespace_id": "1008", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_FILES", "namespace_id": "1009", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_CONTROL", "namespace_id": "1010", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["0 * * * *", "30 3 * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://bloop.here",
    "FILE_SOURCE": "mock",
    "OPEN_PATH_MODE": "redirect",
    "TOKEN_MODE": "refresh",
    "CODE_LENGTH": "6",
    "CODE_TTL_SECONDS": "60",
    "CODE_GRACE_SECONDS": "10",
    "CLAIM_TIMEOUT_SECONDS": "300",
    "UPLOAD_TIMEOUT_SECONDS": "900",
    "SESSION_MAX_MINUTES": "720",
    "SESSION_DEFAULT_MINUTES": "60",
    "LINK_FIRST_FETCH_SECONDS": "600",
    "LINK_FETCH_WINDOW_SECONDS": "120",
    "LINK_MAX_FETCHES": "10",
    "LINK_MINTS_PER_ITEM": "5",
    "LINK_BINDING_DEFAULT": "log",
    "GRAPH_DOWNLOAD_HOSTS": "*.sharepoint.com,*.files.1drv.com,my.microsoftpersonalcontent.com",
    "GUEST_DROP": "open",
    "GUEST_MAX_BYTES": "94371840",
    "GUEST_STORAGE_BUDGET_BYTES": "5368709120",
    // R2 has no platform spending cap: these stop bloop at 50% of the free tier per UTC calendar month (1M class A, 10M class B), since the billing period may not align with calendar months.
    "R2_CLASS_A_MONTHLY_CAP": "500000",
    "R2_CLASS_B_MONTHLY_CAP": "5000000",
    "DEMO_ENABLED": "true",
    "DEMO_MAX_MINUTES": "120",
    "DEMO_GUEST_MAX_BYTES": "26214400",
    "DEMO_MAX_CONCURRENT": "100",
    "DEMO_MAX_PER_IP": "12",
    "AUDIT_RETENTION_DAYS": "180",
    "METRICS_RETENTION_DAYS": "90",
    "DEMO_RETENTION_DAYS": "7",
    "GRANT_IDLE_DAYS": "30",
    "ENTRA_AUTHORITY": "https://login.microsoftonline.com/organizations/v2.0",
    "ENTRA_CLIENT_ID": "",
    "ENTRA_SCOPES": "openid offline_access Files.Read",
    "TOKEN_KEK_CURRENT": "k1"
  }
}
