{
  "name": "bloop",
  "version": "0.0.0",
  "private": true,
  "description": "Phone-approved handover of a user's own file to a shared screen.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "wrangler d1 migrations apply bloop --local --persist-to .wrangler/state",
    "dev": "wrangler dev --enable-containers=false --infer-origin-from-routes=false --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.public.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:cov": "vitest run --coverage --coverage.reporter=text-summary --coverage.include=src/** --coverage.include=public/js/**",
    "html-validate": "html-validate public",
    "size": "npm run build:assets && size-limit && node tools/size-headroom.mjs",
    "build:pages": "node tools/build-pages-cli.mjs",
    "check:pages": "node tools/build-pages-cli.mjs --check",
    "build:assets": "node tools/build-assets-cli.mjs",
    "build": "npm run build:pages && npm run build:assets",
    "check": "npm run check:pages && npm run build:assets && npm run typecheck && npm run lint && npm test && npm run test:int && npm run html-validate && npm run size",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "oauth4webapi": "3.8.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "5.20261122.2",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "fast-check": "4.11.0",
    "html-validate": "11.21.1",
    "marked": "18.3.0",
    "size-limit": "14.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
