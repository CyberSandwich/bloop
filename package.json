{
  "name": "bloop",
  "version": "0.0.0",
  "private": true,
  "description": "Phone-approved handover of a user's own file to a shared screen.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "wrangler d1 migrations apply bloop --local --persist-to .wrangler/state",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.public.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:cov": "vitest run --coverage --coverage.reporter=text-summary --coverage.include=src/** --coverage.include=public/js/**",
    "html-validate": "html-validate public",
    "size": "size-limit",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:int && npm run html-validate && npm run size",
    "test:e2e": "playwright test"
  },
  "size-limit": [
    {
      "name": "browser JS",
      "path": [
        "public/js/**/*.js",
        "!public/js/robin.js",
        "!public/js/core/robin-math.js",
        "!public/js/demo/**"
      ],
      "limit": "40 kB"
    },
    {
      "name": "live demo (lazy)",
      "path": "public/js/demo/**/*.js",
      "limit": "4 kB"
    },
    {
      "name": "robin renderer",
      "path": [
        "public/js/robin.js",
        "public/js/core/robin-math.js"
      ],
      "gzip": true,
      "limit": "6.5 kB"
    },
    {
      "name": "robin mesh",
      "path": "public/robin.bin",
      "gzip": false,
      "brotli": false,
      "limit": "21 kB"
    },
    {
      "name": "font",
      "path": "public/fonts/inter-latin.woff2",
      "brotli": false,
      "limit": "55 kB"
    },
    {
      "name": "demo deck",
      "path": "src/worker/seams/file-source/demo-files/demo-deck.pptx",
      "gzip": false,
      "brotli": false,
      "limit": "85 kB"
    },
    {
      "name": "demo PDF",
      "path": "src/worker/seams/file-source/demo-files/demo-handout.pdf",
      "gzip": false,
      "brotli": false,
      "limit": "85 kB"
    },
    {
      "name": "site CSS",
      "path": "public/css/app.css",
      "gzip": true,
      "limit": "12 kB"
    }
  ],
  "dependencies": {
    "oauth4webapi": "3.8.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "5.20261122.2",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.11.0",
    "html-validate": "11.21.1",
    "size-limit": "14.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
