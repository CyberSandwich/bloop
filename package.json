{
  "name": "bloop",
  "version": "0.0.0",
  "private": true,
  "description": "Phone-approved handover of a user's own file to a shared screen.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "wrangler d1 migrations apply bloop --local --persist-to .wrangler/state",
    "dev": "wrangler dev --infer-origin-from-routes=false --ip 127.0.0.1 --port 8787 --persist-to .wrangler/state",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.public.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:cov": "vitest run --coverage --coverage.reporter=text-summary --coverage.include=src/** --coverage.include=public/js/**",
    "html-validate": "html-validate public",
    "size": "npm run build:assets && size-limit",
    "build:pages": "node tools/build-pages-cli.mjs",
    "check:pages": "node tools/build-pages-cli.mjs --check",
    "build:assets": "node tools/build-assets.mjs",
    "build": "npm run build:pages && npm run build:assets",
    "check": "npm run check:pages && npm run build:assets && npm run typecheck && npm run lint && npm test && npm run test:int && npm run html-validate && npm run size",
    "test:e2e": "playwright test"
  },
  "size-limit": [
    {
      "name": "landing JS",
      "path": "dist/js/site.js",
      "limit": "1.15 kB"
    },
    {
      "name": "doc pages JS",
      "path": [
        "dist/js/core/icons.js",
        "dist/js/core/ui.js",
        "dist/js/legal.js"
      ],
      "limit": "1.95 kB"
    },
    {
      "name": "room screen JS",
      "path": [
        "dist/js/core/api.js",
        "dist/js/core/channel.js",
        "dist/js/core/copy-screen.js",
        "dist/js/core/copy.js",
        "dist/js/core/demo.js",
        "dist/js/core/format.js",
        "dist/js/core/icons.js",
        "dist/js/core/loader.js",
        "dist/js/core/qr.js",
        "dist/js/core/rows.js",
        "dist/js/core/states.js",
        "dist/js/core/store.js",
        "dist/js/core/timing.js",
        "dist/js/core/ui.js",
        "dist/js/core/verified.js",
        "dist/js/launcher.js",
        "dist/js/residue.js",
        "dist/js/screen.js",
        "dist/js/shared/codes.js",
        "dist/js/shared/errors.js",
        "dist/js/shared/session.js",
        "dist/js/vendor/uqr.js",
        "dist/js/viewer.js"
      ],
      "limit": "23.7 kB"
    },
    {
      "name": "phone JS",
      "path": [
        "dist/js/core/api.js",
        "dist/js/core/boot-code.js",
        "dist/js/core/channel.js",
        "dist/js/core/copy-phone.js",
        "dist/js/core/copy.js",
        "dist/js/core/demo.js",
        "dist/js/core/drop.js",
        "dist/js/core/files.js",
        "dist/js/core/format.js",
        "dist/js/core/icons.js",
        "dist/js/core/loader.js",
        "dist/js/core/rows.js",
        "dist/js/core/states.js",
        "dist/js/core/store.js",
        "dist/js/core/timing.js",
        "dist/js/core/toast.js",
        "dist/js/core/ui.js",
        "dist/js/core/verified.js",
        "dist/js/phone.js",
        "dist/js/shared/codes.js",
        "dist/js/shared/errors.js",
        "dist/js/shared/names.js",
        "dist/js/shared/session.js"
      ],
      "limit": "15.95 kB"
    },
    {
      "name": "typed code JS",
      "path": [
        "dist/js/code.js",
        "dist/js/core/api.js",
        "dist/js/core/copy-code.js",
        "dist/js/core/copy.js",
        "dist/js/core/format.js",
        "dist/js/core/icons.js",
        "dist/js/core/store.js",
        "dist/js/core/timing.js",
        "dist/js/core/ui.js",
        "dist/js/shared/codes.js",
        "dist/js/shared/errors.js"
      ],
      "limit": "5.15 kB"
    },
    {
      "name": "phone media, lazy",
      "path": [
        "dist/js/core/photo.js",
        "dist/js/core/video.js"
      ],
      "limit": "1.75 kB"
    },
    {
      "name": "screen video, lazy",
      "path": "dist/js/viewer-video.js",
      "limit": "0.5 kB"
    },
    {
      "name": "session length sheet, lazy",
      "path": [
        "dist/js/core/lazy.js",
        "dist/js/core/length.js",
        "dist/js/shared/length.js"
      ],
      "limit": "1.45 kB"
    },
    {
      "name": "session length sheet CSS, lazy",
      "path": "public/css/length.css",
      "gzip": true,
      "limit": "0.8 kB"
    },
    {
      "name": "phone remote, lazy",
      "path": [
        "dist/js/core/lazy.js",
        "dist/js/core/remote-ui.js",
        "dist/js/core/remote.js"
      ],
      "limit": "2.1 kB"
    },
    {
      "name": "phone remote CSS, lazy",
      "path": "public/css/remote.css",
      "gzip": true,
      "limit": "0.9 kB"
    },
    {
      "name": "drag and drop, lazy",
      "path": "dist/js/core/drag.js",
      "limit": "0.25 kB"
    },
    {
      "name": "font",
      "path": "public/fonts/inter-latin.woff2",
      "brotli": false,
      "limit": "55 kB"
    },
    {
      "name": "demo deck",
      "path": "src/worker/seams/file-source/demo-files/demo-deck.pptx",
      "gzip": false,
      "brotli": false,
      "limit": "85 kB"
    },
    {
      "name": "demo PDF",
      "path": "src/worker/seams/file-source/demo-files/demo-handout.pdf",
      "gzip": false,
      "brotli": false,
      "limit": "85 kB"
    },
    {
      "name": "demo photo",
      "path": "src/worker/seams/file-source/demo-files/demo-dog.jpg",
      "gzip": false,
      "brotli": false,
      "limit": "241 kB"
    },
    {
      "name": "legal page CSS",
      "path": "public/css/legal.css",
      "gzip": true,
      "limit": "2.65 kB"
    },
    {
      "name": "site page CSS",
      "path": [
        "public/css/base.css",
        "public/css/site.css"
      ],
      "gzip": true,
      "limit": "8.25 kB"
    },
    {
      "name": "app page CSS",
      "path": [
        "public/css/base.css",
        "public/css/app.css"
      ],
      "gzip": true,
      "limit": "10.5 kB"
    },
    {
      "name": "hero image",
      "path": "public/img/hero-viewer-1440.avif",
      "gzip": false,
      "brotli": false,
      "limit": "157.5 kB"
    },
    {
      "name": "hero image fallback",
      "path": "public/img/hero-viewer-1440.webp",
      "gzip": false,
      "brotli": false,
      "limit": "197 kB"
    },
    {
      "name": "phone hero image",
      "path": "public/img/hero-phone-900.avif",
      "gzip": false,
      "brotli": false,
      "limit": "76 kB"
    },
    {
      "name": "phone hero image fallback",
      "path": "public/img/hero-phone-900.webp",
      "gzip": false,
      "brotli": false,
      "limit": "85 kB"
    }
  ],
  "dependencies": {
    "oauth4webapi": "3.8.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "5.20261122.2",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@size-limit/file": "14.3.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "fast-check": "4.11.0",
    "html-validate": "11.21.1",
    "marked": "18.3.0",
    "size-limit": "14.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
