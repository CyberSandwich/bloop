# Local Worker secrets. `cp .dev.vars.example .dev.vars`.
# Every value below is fake. Plain vars live in wrangler.jsonc; list one here only to override it locally.
# localhost, not 127.0.0.1: WebAuthn refuses an IP address as its relying party (ADR 0014).
PUBLIC_ORIGIN=http://localhost:8787
FILE_SOURCE=mock
# No file origin locally: the production workers.dev host from wrangler.jsonc must not reach a local page's CSP.
FILE_ORIGIN=
ENTRA_CLIENT_SECRET=fake-entra-client-secret
TOKEN_KEKS={"k1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
COOKIE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
HASH_PEPPER=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
IT_EXPORT_TOKEN=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=fake-r2-access-key-id
R2_SECRET_ACCESS_KEY=fake-r2-secret-access-key
FILE_TOKEN_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB
FILE_TOKEN_KEY_PREVIOUS=DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD
CODE_PEPPER=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TALLY_SIGNING_SECRET=fake-tally-signing-secret
ADMIN_EMAILS=admin@example.test
TEST_EMAILS=test@example.test
# Mail stays in memory and is read at /api/dev/mailbox; config refuses it unless PUBLIC_ORIGIN is local.
DEV_MAILBOX=1
# Local R2 has no S3 endpoint to presign against; set a local origin to route presigned URLs to the dev proxy. Config refuses it on a deployed origin.
R2_DEV_ENDPOINT=
# Test only: a local stand-in for i.ytimg.com that the thumbnail route fetches from. Config refuses it on a deployed origin.
YT_THUMB_ORIGIN=
